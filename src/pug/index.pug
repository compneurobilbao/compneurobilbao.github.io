            section#organisers.section
                .container
                    .section-heading
                        p.eyebrow Organised by
                        h2 Three universities, one shared meeting.
                    .organiser-grid
                        article.organiser-card
                            .university-logo
                                img(src='assets/ehu.jpg', alt='University of the Basque Country logo', loading='lazy')
                            h3 University of the Basque Country
                            p
                                a(href='https://scholar.google.com/citations?user=BIfo1BAAAAAJ&hl=en', target='_blank', rel='noopener noreferrer') Jesús M. Cortes
                        article.organiser-card
                            .university-logo
                                img(src='assets/ugent.svg', alt='Ghent University logo', loading='lazy')
                            h3 Ghent University
                            p
                                a(href='https://scholar.google.com/citations?user=OJbWSLoAAAAJ&hl=en', target='_blank', rel='noopener noreferrer') Daniele Marinazzo
                        article.organiser-card
                            .university-logo.comenius-logo
                                img(src='assets/comenius.png', alt='Comenius University in Bratislava logo', loading='lazy')
                            h3 Comenius University Bratislava
                            p
                                a(href='https://scholar.google.com/citations?hl=en&user=UZUQ-2QAAAAJ', target='_blank', rel='noopener noreferrer') Michal Javorka

            section#registration.section
                .container
                    .registration-panel
                        .registration-copy
                            p.eyebrow Student applications
                            h2 Apply for a place. Fee: €0.
                            p Applications are open until 30 November 2026, and 70 seats are available. If we receive more than 70 applications, the organising committee will select participants using the information submitted and send tickets to those selected. If we receive 70 applications or fewer, every applicant will receive a ticket and the application form will reopen for the remaining seats.
                            ul.application-requirements
                                li Contact and university details
                                li A short motivation letter
                                li Your CV (PDF)
                        .registration-action
                            span.status-label Google Form application
                            a.btn.btn-light.btn-lg(href='https://forms.gle/s3jyVLcZRQVbqkBQ9', target='_blank', rel='noopener noreferrer') Apply now

        footer
            .container.footer-inner
                p MIND 2026 · Bilbao · 14–15 December 2026
                a(href='#page-top') Back to top ↑

        script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js')
