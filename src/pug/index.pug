                            p Associate Professor · Mondragon Unibertsitatea
                        article.person-card
                            p.person-type Local speaker
                            h3
                                a(href='https://scholar.google.com/citations?user=13EhJDYAAAAJ&hl=en', target='_blank', rel='noopener noreferrer') Ibai Diez
