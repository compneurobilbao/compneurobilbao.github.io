doctype html
html(lang='en')
    head
        meta(charset='utf-8')
        meta(name='viewport', content='width=device-width, initial-scale=1')
        meta(name='description', content='MIND 2026 — International Meeting on Multiscale & Integrative Neuro-physiological Data, 14–15 December 2026 in Bilbao.')
        meta(name='author', content='MIND 2026')
        title MIND 2026 | Bilbao
        link(rel='icon', type='image/x-icon', href='assets/favicon.ico')
        link(rel='preconnect', href='https://fonts.googleapis.com')
        link(rel='preconnect', href='https://fonts.gstatic.com', crossorigin='')
        link(href='https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@600;700;800&display=swap', rel='stylesheet')
        link(href='css/styles.css', rel='stylesheet')

    body#page-top
        .spectrum-strip(aria-hidden='true')

        nav#mainNav.navbar.navbar-expand-lg.fixed-top(aria-label='Main navigation')
            .container
                a.navbar-brand(href='#page-top', aria-label='MIND 2026 home') MIND #[span 2026]
                button.navbar-toggler(type='button', data-bs-toggle='collapse', data-bs-target='#navbarMenu', aria-controls='navbarMenu', aria-expanded='false', aria-label='Toggle navigation')
                    span.navbar-toggler-icon
                #navbarMenu.collapse.navbar-collapse
                    ul.navbar-nav.ms-auto.align-items-lg-center
                        li.nav-item
                            a.nav-link(href='#meeting') Meeting
                        li.nav-item
                            a.nav-link(href='#speakers') Speakers
                        li.nav-item
                            a.nav-link(href='#organisers') Organisers
                        li.nav-item
                            a.nav-link.registration-link(href='#registration') Apply

        main
            header.hero
                .container
                    .row.align-items-center.g-5
                        .col-lg-7
                            p.eyebrow International meeting
                            h1 MIND #[span 2026]
                            h2 Multiscale & Integrative #[br] Neuro-physiological Data
                            p.hero-copy Two focused days connecting neurophysiological data, brain–body interactions and biomedical applications.
                            .hero-actions
                                a.btn.btn-primary.btn-lg(href='#registration') Apply for a place
                                a.text-link(href='#meeting') Discover the meeting #[span(aria-hidden='true') ↓]
                        .col-lg-5
                            .event-card
                                .event-detail
                                    span.detail-label Dates
                                    strong 14–15 December 2026
                                .event-detail
                                    span.detail-label Venue
                                    strong Bizkaia Aretoa
                                    span Bilbao · University of the Basque Country
                                .event-note
                                    span.dot
                                    | In person · Free for students

            section#meeting.section
                .container
                    .section-heading
                        p.eyebrow The meeting
                        h2 Built for exchange, kept simple.
                    .row.g-4
                        .col-lg-7
                            .content-card.audience-card
                                span.card-number 01
                                h3 Who it is for
                                p Biomedical engineering students from the Basque Country and nearby regions, alongside researchers, clinical professionals, engineers, technology centres and companies in the biomedical ecosystem.
                        .col-lg-5
                            .content-card.topics-card
                                span.card-number 02
                                h3 Topics
                                p Neurophysiological data, brain–body interactions and translation into clinical applications and medical devices.
                                ul.topic-list
                                    li Neurotechnology
                                    li Electromedicine
                                    li Multimodal neuroimaging
                                    li Physiological analysis

            section#speakers.section.section-tint
                .container
                    .section-heading
                        p.eyebrow Programme
                        h2 Speakers across career stages
                        p Researchers working across computational neuroscience, physiology and biomedical engineering.
                    .speaker-level
                        .level-heading
                            p.eyebrow Senior researchers
                            h3 Invited &amp; local speakers
                    .speaker-grid
                        article.person-card
                            p.person-type Invited speaker
                            h3
                                a(href='https://scholar.google.com/citations?user=54KX1rIAAAAJ&hl=it', target='_blank', rel='noopener noreferrer') Sebastiano Stramaglia
                            p Full Professor in Applied Physics · University of Bari, Italy
                        article.person-card
                            p.person-type Local speaker
                            h3
                                a(href='https://scholar.google.com/citations?user=4WgXIToAAAAJ&hl=es', target='_blank', rel='noopener noreferrer') Begoña García-Zapirain Soto
