                            article.person-card
                                p.person-type Postdoctoral researcher
                                h3
                                    a(href='https://scholar.google.com/citations?hl=it&user=FJIq6NEAAAAJ', target='_blank', rel='noopener noreferrer') Giulio Tani Raffaelli
                                p Ghent University
                            article.person-card
                                p.person-type Postdoctoral researcher
                                h3
                                    a(href='https://scholar.google.com/citations?user=zVjCyDgAAAAJ&hl=it', target='_blank', rel='noopener noreferrer') Borja Camino-Pontes
                                p Computational Neuroimaging Lab at Biobizkaia

